# Copy to .env and fill in. Never commit .env.
# Which LLM backend to use: gemini | fake
LLM_PROVIDER=
GEMINI_API_KEY=
# Model name; empty = default (gemini-3.5-flash-lite). Availability depends on the
# account: check a model with a real call, see docs/decisions/0002-gemini-model-choice.md
GEMINI_MODEL=
# Seconds to wait for the next token before sending an error (default 30)
LLM_TIMEOUT_SECONDS=
# Postgres connection string (Neon), e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# RAG: chunks retrieved per question (default 5) and the minimum cosine similarity of the
# best chunk; below it the app says "I don't know" without calling the LLM.
RETRIEVAL_TOP_K=
SIMILARITY_THRESHOLD=
