# Copy to .env and fill in. Never commit .env.
# Secret that signs login tokens (required, at least 32 characters; the app refuses to start
# without it). Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Token lifetime in minutes (default 1440 = 24 h)
JWT_EXPIRE_MINUTES=
# If set, registration requires this code (empty = open registration)
REGISTRATION_CODE=
# Requests per minute per IP for /auth/* (default 5)
AUTH_RATE_LIMIT_PER_MINUTE=
# Requests per minute per IP (default 10) and LLM calls per minute for the whole service (default 5)
RATE_LIMIT_PER_MINUTE=
GLOBAL_RPM=
# USD per 1M input / output tokens, used for the cost estimate in the llm_calls table (default 0)
PRICE_IN_PER_M=
PRICE_OUT_PER_M=
# Which LLM backend to use: gemini | fake
LLM_PROVIDER=
GEMINI_API_KEY=
# Model name; empty = default (gemini-3.5-flash-lite). Availability depends on the
# account: check a model with a real call, see docs/decisions/0002-gemini-model-choice.md
GEMINI_MODEL=
# Seconds to wait for the next token before sending an error (default 30)
LLM_TIMEOUT_SECONDS=
# Postgres connection string (Neon), e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# RAG: chunks retrieved per question (default 5) and the minimum cosine similarity of the
# best chunk; below it the app says "I don't know" without calling the LLM.
RETRIEVAL_TOP_K=
SIMILARITY_THRESHOLD=
# Retriever: vector (pgvector only, the original behaviour) | bm25 | hybrid (default; RRF of both
# plus the lexical "I don't know" gate). Candidates per retriever before fusion (default 20).
RETRIEVAL_MODE=
RETRIEVAL_CANDIDATES=
# Browser origins allowed to call the API, comma-separated (default http://localhost:5173).
# In production: the deployed SPA URL, e.g. https://mnemonic.pages.dev
CORS_ORIGINS=
